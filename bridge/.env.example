# --- Conexión con tu Supabase (los mismos valores públicos que usa la web) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# --- Tu cuenta de Forja (el bridge entra como si fueras tú; debe ser miembro del estudio) ---
FORJA_EMAIL=
FORJA_PASSWORD=

# --- Solo para dispositivos tipo PC: carpetas que quieres exponer, separadas por ; ---
# Windows:  PC_ROOTS=D:\Juegos;C:\Users\Tu\Proyectos
# Linux/Mac: PC_ROOTS=/home/tu/juegos;/home/tu/proyectos
PC_ROOTS=

# --- Opcional ---
# 1 = permitir que desde la web se mueva el ratón / se use el teclado de este PC (requiere robotjs)
ALLOW_INPUT=1
